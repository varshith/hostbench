{
  "name": "hostbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Continuous multi-region benchmark of static, edge and PaaS hosting platforms",
  "scripts": {
    "dev": "node --import tsx scripts/publish-data.ts && astro dev",
    "build": "node --import tsx scripts/publish-data.ts && astro build",
    "preview": "astro preview",
    "check": "tsc -p tsconfig.scripts.json --noEmit && astro check",
    "measure": "node --import tsx scripts/measure.ts",
    "aggregate": "node --import tsx scripts/aggregate.ts",
    "pipeline": "npm run measure && npm run aggregate"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
